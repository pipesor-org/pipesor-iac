# Replace placeholders only after target, access and recovery review. No real credentials.
subscription_id = "<target-subscription-uuid>"
tenant_id = "<target-tenant-uuid>"
settings = {
  account_name = "<globally-unique-storage-name>"
  location = "<approved-azure-region>"
  replication = "<approved-redundancy>"
  recovery_days = "<approved-integer-1-to-365>"
  principal_ids = ["<environment-specific-principal-object-uuid>"]
  allowed_ips = ["<approved-public-ip-or-range>"]
}
