# Separately bootstrap and authorize this backend before use; no backend exists here.
# Use a distinct container and environment-scoped RBAC, not merely a distinct key.
storage_account_name = "<approved-state-storage-account>"
container_name       = "<dedicated-preprod-state-container>"
key                  = "preprod/foundation.tfstate"
use_azuread_auth     = true
# Authentication comes from the approved execution environment; never add keys/secrets.
