# Replace with reviewed environment values; these placeholders are not deployment inputs.
subscription_id = "<target-subscription-uuid>"
location        = "<approved-azure-region-code>"

# Keep null until this environment is explicitly selected for platform provisioning.
container_platform = null
# Replace every placeholder with reviewed values to opt in:
# container_platform = {
#   location = "<approved-workload-region>"
#   vnet_address_prefix = "<approved-private-vnet-cidr>"
#   infrastructure_subnet_prefix = "<approved-dedicated-aca-subnet-cidr>"
#   log_retention_days = <approved-integer-30-to-730>
#   log_daily_cap_gb = <approved-positive-ingestion-limit>
# }

# Opt in only with reviewed values; namespace names must be globally available and distinct per environment.
service_bus = null
# service_bus = {
#   namespace_name = "<approved-globally-unique-namespace-name>"
#   location       = "<approved-workload-region>"
# }

# Requires container_platform; replace all values with reviewed environment inputs.
postgresql = null
# postgresql = {
#   server_name = "<globally-available-server-name>"
#   location = "<same-region-as-platform>"
#   subnet_prefix = "<dedicated-postgresql-subnet-cidr>"
#   tenant_id = "<tenant-uuid>"
#   administrator = {
#     object_id = "<entra-administrator-object-uuid>"
#     principal_name = "<entra-administrator-name>"
#     principal_type = "<Group-User-or-ServicePrincipal>"
#   }
# }

# Requires container_platform; shares its workspace/location. No app instrumentation is configured.
application_insights_enabled = false

