# Candidate DEV foundations; this file authorizes no Azure operation.
# Resolve the operator/admin markers and feasibility gates in docs/dev-provisioning.md.
subscription_id = "04f339b7-f969-4e17-801c-da6e81e78ffd"
location        = "westus3"

container_platform = {
  location                     = "westus3"
  vnet_address_prefix          = "10.50.0.0/16"
  infrastructure_subnet_prefix = "10.50.1.0/24"
  log_retention_days           = 30
  log_daily_cap_gb             = 0.1
}
service_bus = {
  namespace_name = "sb-pipesor-dev-04f339b7"
  location       = "westus3"
  # Runtime manifest messaging topology (pipesor-docs development/runtime-manifest.md).
  topology = {
    topic_name                 = "workflow-evidence"
    message_ttl                = "P14D"
    duplicate_detection_window = "PT10M"
    subscriptions = {
      pipeline  = { sql_filter = "eventType = 'execution.snapshot'", lock_duration = "PT1M", max_delivery_count = 10 }
      log-event = { sql_filter = "eventType = 'protected_workflow_evidence'", lock_duration = "PT1M", max_delivery_count = 10 }
      nlp       = { sql_filter = "eventType = 'protected_workflow_evidence'", lock_duration = "PT2M", max_delivery_count = 10 }
    }
  }
}
postgresql = {
  server_name   = "pg-pipesor-dev-04f339b7"
  location      = "westus3"
  subnet_prefix = "10.50.2.0/28"
  sku           = { name = "Standard_D2s_v3", tier = "GeneralPurpose" }
  tenant_id     = "0e0cb060-09ad-49f5-a005-68b9b49aa1f6"
  administrator = {
    object_id      = "REPLACE_WITH_POSTGRES_ADMIN_OBJECT_ID"
    principal_name = "REPLACE_WITH_POSTGRES_ADMIN_PRINCIPAL_NAME"
    principal_type = "User"
  }
}
application_insights_enabled = false
foundry = {
  account_name = "ai-pipesor-dev-04f339b7"
  project_name = "pipesor-dev"
  location     = "westus3"
  # Existing deployments are imported (docs/dev-runtime-deployment.md); capacity is thousands of tokens per minute.
  deployments = {
    # Diagnosis model selected by ADR-026 (pipesor-docs); gpt-4o remains as the PD-026 smoke-test baseline.
    pipesor-dev-diagnostics-luna = { model_name = "gpt-6-luna", model_version = "2026-09-22", sku_name = "DataZoneStandard", capacity = 20 }
    pipesor-dev-diagnostics      = { model_name = "gpt-4o", model_version = "2024-11-20", sku_name = "DataZoneStandard", capacity = 20 }
    pipesor-dev-embeddings       = { model_name = "text-embedding-3-small", model_version = "1", sku_name = "DataZoneStandard", capacity = 20 }
  }
}
# Static Web Apps is not offered in the subscription's allowed regions; the dashboard is a Container App (workloads).
static_web_app = null
# App material (signing keys, GitHub App material, registry token, authority document) and OAuth custody vaults.
key_vault = {
  app_material_name    = "kv-pipesor-dev-04f339b7"
  location             = "westus3"
  tenant_id            = "0e0cb060-09ad-49f5-a005-68b9b49aa1f6"
  allowed_public_ipv4s = ["REPLACE_WITH_OPERATOR_PUBLIC_IPV4/32"]
  custody              = { name = "kv-pipesor-dev-usr" }
}
# Phase 2 only, after the operator stored the secrets (docs/dev-runtime-deployment.md).
workloads = null
