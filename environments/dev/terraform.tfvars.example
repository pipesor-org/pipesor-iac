# This handoff creates no resources and is unnecessary for foundation provisioning.
rag_runtime_contract = null

# RAG v0.1 handoff only; requires platform, Foundry and PostgreSQL opt-ins.
# Supplying these identifiers does not create identities, app roles, assignments, model deployments or SQL grants.
